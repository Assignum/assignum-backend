{
  "name": "assignum-backend",
  "version": "1.0.0",
  "description": "Assignum backend — Node.js + Express + TypeScript + Firebase Admin SDK",
  "scripts": {
    "dev": "cross-env DOTENV_CONFIG_PATH=./config/.env.development nodemon --exec \"ts-node ./src/main\" --watch ./src --ext .ts",
    "build": "shx rm -rf dist && tsc --project tsconfig.prod.json",
    "start": "cross-env DOTENV_CONFIG_PATH=./config/.env.production node -r dotenv/config -r module-alias/register ./dist/main.js",
    "type-check": "tsc -b --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "_moduleAliases": {
    "@src": "dist"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.2.0",
    "module-alias": "^2.3.4",
    "morgan": "^1.11.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@swc/core": "^1.15.40",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/module-alias": "^2.0.4",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
